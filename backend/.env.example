# OpsRadar backend configuration
# LLM_PROVIDER: gemini | openai | anthropic | none
# "none" runs the full deterministic template mode (no API key needed).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Upload guard (megabytes per request)
MAX_UPLOAD_MB=25

# Storage locations (optional overrides)
# OPSRADAR_DATA_DIR=./data
# OPSRADAR_DEMO_DIR=./demo_data
